  <style type="text/css">
    @media(min-width: 990px) {
      #productboard_feedback_iframe { width: 100%; }
      #productboard_feedback_modal_dialog { width: 960px; }
    }
  </style>
  <script type="text/javascript">
    function showFeedbackModal() {
      resetProductboardModal();
      $.ajax({
        type: "POST",
        url: "/jwordenandsonspaving/productboard_feedback",
        beforeSend: $.rails.CSRFProtection,
        success: function (response_markup) {
          loadProductboardIframe(response_markup);
        }
      });

      function resetProductboardModal() {
        $('#productboard_feedback_modal_markup').html('').hide();
        $('#productboard_feedback_loader').show();
        $('#productboard_feedback_loading_message').html('');
        $('#productboard_feedback_modal_markup').height(0);
        $('#productboard_feedback_iframe').height(0);
        setTimeout(function() {
          $('#productboard_feedback_loading_message').html('There may be a problem. Please check back shortly.')
        }, 5000);
      }

      function loadProductboardIframe(response_markup) {
        $('#productboard_feedback_modal_markup').html(response_markup);
        $('#productboard_feedback_iframe').load(function() {
          var modal_height = parseInt(window.innerHeight * 0.7);
          $('#productboard_feedback_loader').hide();
          $('#productboard_feedback_iframe').height(modal_height);
          $('#productboard_feedback_modal_markup').height(modal_height);
          $('#productboard_feedback_modal_markup').show();
        });
      }

      $('#productboard_feedback_modal').modal('show');
    }
  </script>


  <style type="text/css">
    .color-dot {
      border-radius: 99px;
      display:inline-block;
      height:10px;
      margin-left: 5px;
      margin-right:3px;
      width:10px;
    }
    .color-dot.critical { background-color: #e74c3c;}
    .color-dot.major { background-color: #e67e22;}
    .color-dot.minor { background-color: #f1c40f; }
    .color-dot.none { background-color: #2ecc71; }
  </style>


# Fly.io — only send the backend application code
# Ignore everything that isn't needed to run the Python API

# Frontend build artifacts and source
node_modules/
dist/
public/

# Exclude all of src/ EXCEPT the config files the backend needs.
#
# Every un-ignore here is load-bearing at BOOT. va_market_geo.py reads
# virginiaMarketPages.json at import time; when this file was added to src/
# without an exception below, every app machine crash-looped with
# FileNotFoundError and the API served 503 — while CI stayed green, because
# the test job imports from the repo checkout, which has the file. The image
# is the only place the exclusion bites. test_docker_image_contents.py now
# asserts each backend-read file under src/ survives this filter.
src/
!src/config/
!src/config/siteFactoryManifest.json
!src/data/
src/data/*
!src/data/virginiaMarketPages.json
*.html
*.jsx
*.tsx
*.ts
*.css
*.svg
*.png
*.jpg
*.jpeg
*.avif
*.webp
*.mp4
*.gif

# Other repos and large directories
apps/
scavenged-assets/
jworden_leads.db
jwordenai operation system/
external-repos/
jwordenasphaltpaving/
blueridgeasphaltpaving/
minnesotaasphaltpaving/
atlantapavingandsealing/
obxpaving/
atlantaasphaltpavingpros/
asphaltpavingkansascity/
michiganasphaltpavingpros/
savannahasphaltpaving/

# Dev tools and config
.vite/
.vite-cache/
vite.config.*
tailwind.config.*
postcss.config.*
eslint.config.*
.eslintrc*
.prettierrc*
tsconfig*

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# Local dev
.env.local
.env.vercel*
.git/
.github/
*.log
*.md
*.sh
scripts/
# ...but the Fly release_command runs INSIDE the image, so the one script it
# needs must survive. Excluding all of scripts/ made db_release.sh missing at
# runtime and every deploy aborted with exit 127 before the schema step ran.
# The rest of scripts/ is build-time Node tooling and stays out.
!scripts/db_release.sh

# Vercel / Netlify deploy
.vercel/
.netlify/
